# ============================================================
# Microblink — configuration runtime
# ============================================================
# Copie ce fichier en `.env` A COTE du docker-compose.yml, renseigne la
# licence, puis deploie : setup.sh -> option m.
#
# Les noms sont EXACTEMENT ceux attendus par docker-compose.yml : ce que tu
# lis ici est ce qui tourne. Aucune traduction, aucun prefixe.
# ============================================================

# ── Licence (OBLIGATOIRE) ────────────────────────────────────
# LICENSEE est encode DANS la cle : les deux vont ensemble, toujours.
LICENSEE=
LICENSE_KEY=

# Image du moteur, epinglee par digest de liste de manifestes (multi-arch).
# Correspond a la 5.0.1, publiee sous le tag 5.0 — voir docker-compose.yml pour
# pourquoi ni 5.0.0 ni 5.0.1 ne conviennent.
MB_ENGINE_IMAGE=microblink/api@sha256:3f24bc799ceec86b06e9395317e14e2b236c43f2c26ccc8cb0adffb32f85c5f5
API_VERSION=1.3.0

# ── Ports ────────────────────────────────────────────────────
# Plage 9xxx : 8000 et 8080 sont deja pris par l'API OCR Python (KYC_BIND_PORT)
# et par nginx sur les serveurs .66/.67.
#
# PORT          : port INTERNE au conteneur moteur
# HOST_PORT     : moteur Microblink sur l'hote (diagnostic uniquement)
# API_HOST_PORT : facade Go sur l'hote — derriere le LB nginx en .66
PORT=9080
HOST_PORT=9080
API_HOST_PORT=9000

# ── Facade Go ────────────────────────────────────────────────
MAX_UPLOAD_MB=20
DEFAULT_AGE_LIMIT=18
REQUEST_TIMEOUT_S=60
# Conversion des formats refuses par Microblink (WebP, GIF, TIFF, BMP)
CONVERT_TARGET=jpeg
CONVERT_QUALITY=95
# Retry avec scanCroppedDocumentImage quand la detection du document echoue
CROPPED_RETRY=true

# ── Resilience de la licence ─────────────────────────────────
# Defauts de l'image : 1 tentative / 3s d'intervalle / 1s de timeout, sans
# reprise programmee ensuite. Une coupure reseau breve fige le moteur jusqu'au
# redemarrage. On elargit la fenetre a ~5 min.
LICENCE_RETRY_ATTEMPTS=10
LICENCE_RETRY_INTERVAL=30s
LICENCE_CALL_TIMEOUT_MS=15000

# ── Basic Auth du moteur (si ENABLE_SECURITY=true) ───────────
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# ── Maintien en vie de la licence ────────────────────────────
# Intervalle entre deux scans de maintien, en secondes. 0 desactive le service.
#
# Les pannes de licence observees sont toutes survenues apres des dizaines de
# minutes SANS AUCUN SCAN. Ce service envoie une image blanche de 432 octets a
# intervalle regulier pour que le moteur ne reste jamais inactif assez longtemps.
#
# Cout, a arbitrer selon le mode de facturation de la licence :
#   300s  -> 288 scans/jour/noeud    (~17 000/mois pour deux noeuds)
#   900s  ->  96 scans/jour/noeud    (~5 800/mois)   <- defaut
#   1800s ->  48 scans/jour/noeud    (~2 900/mois)
KEEPALIVE_INTERVAL=900
# 1 = une ligne par ping (diagnostic). A 900 s cela fait 96 lignes/jour.
KEEPALIVE_VERBOSE=0
# Bilan periodique, en nombre de pings : la preuve de vie du service.
# 24 pings a 900 s = un bilan toutes les 6 h. 0 desactive le bilan.
KEEPALIVE_SUMMARY_EVERY=24
